@page "/"

<PageTitle>Dashboard</PageTitle>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <MudText Typo="Typo.body1">Volgende wedstrijd ⚽</MudText>
                @if(NextMatch == null)
                {
                    <MudText Typo="Typo.h4">N.B.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h4">@NextMatch.Opponent</MudText>
                    <MudText Typo="Typo.subtitle1">@NextMatch.Location</MudText>
                    <MudText Typo="Typo.subtitle2">@NextMatch.Date.ToString("dd-MM")</MudText>
                }

            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <MudText Typo="Typo.body1">Afgelopen wedstrijd</MudText>
                @if (LastMatch == null)
                {
                    <MudText Typo="Typo.h4">N.B.</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h4">@LastMatch.Score</MudText>
                    <MudText Typo="Typo.subtitle1">@LastMatch.Opponent</MudText>
                    <MudText Typo="Typo.subtitle1">@LastMatch.Location</MudText>
                    <MudText Typo="Typo.subtitle2">@LastMatch.Date.ToString("dd-MM")</MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <MudText Typo="Typo.body1">Huidige eikel 🌰</MudText>
                <MudText Typo="Typo.h4">@CurrentEikel</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <MudText Typo="Typo.body1">Volgende jarig 🎂</MudText>
                <MudText Typo="Typo.h4">@NextBirthdayPlayer?.Name</MudText>
                <MudText Typo="Typo.subtitle1">@NextBirthdayPlayer?.Birthday.ToString("dd-MM-yyyy")</MudText>
                @if(NextBirthdayPlayer?.Birthday.DayOfYear - DateTime.Now.DayOfYear >= 0)
                {
                    <MudText Typo="Typo.subtitle2">Over @((NextBirthdayPlayer?.Birthday.DayOfYear - DateTime.Now.DayOfYear)) dagen</MudText>
                }
                else
                {
                    <MudText Typo="Typo.subtitle2">Over @((NextBirthdayPlayer?.Birthday.AddYears(1).DayOfYear - DateTime.Now.DayOfYear)) dagen</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>