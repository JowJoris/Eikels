@page "/"

<PageTitle>Dashboard</PageTitle>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <p>Volgende wedstrijd</p>
                @if(NextMatch == null)
                {
                    <h1>N.B.</h1>
                }
                else
                {
                    if(NextMatch.Location == "Thuis")
                    {
                        <h1>Bredevoort 3 - @NextMatch.Opponent</h1>
                    }
                    else
                    {
                        <h1>@NextMatch.Opponent - Bredevoort 3</h1>
                    }
                }

            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="12" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <p>Huidige eikel</p>
                <h1>@CurrentEikel</h1>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Class="pa-4" Style="height: 200px;">
                <p>Vaakst verkozen tot Man of the Match</p>
                <h1>@ManOfTheMatchList.OrderByDescending(m => m.Value).FirstOrDefault().Key (@ManOfTheMatchList.OrderByDescending(m => m.Value).FirstOrDefault().Value)</h1>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>