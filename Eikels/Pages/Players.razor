@page "/spelers"
@page "/Eikels/spelers"

@using Eikels.Core.Models

<PageTitle>Spelers</PageTitle>

<MudTable Items="PlayerList" AllowUnsorted="false">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Spelers</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<Player, object>(x => x.Name)">Naam</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Player, object>(x => x.Matches)">Wedstrijden</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Player, object>(x => x.Goals)">⚽</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Player, object>(x => x.Assists)">🦶</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Player, object>(x => x.ManOfTheMatch)">🏆</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Player, object>(x => x.Eikels)">🌰</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Naam">@context.Name</MudTd>
        <MudTd DataLabel="Wedstrijden">@context.Matches</MudTd>
        <MudTd DataLabel="⚽">@context.Goals</MudTd>
        <MudTd DataLabel="🦶">@context.Assists</MudTd>
        <MudTh DataLabel="🏆">@context.ManOfTheMatch</MudTh>
        <MudTh DataLabel="🌰">@context.Eikels</MudTh>
    </RowTemplate>
</MudTable>