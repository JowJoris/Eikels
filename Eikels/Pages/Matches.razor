@page "/wedstrijden"
@page "/Eikels/wedstrijden"


<PageTitle>Wedstrijden</PageTitle>

<MudTable Items="MatchList" Dense="true">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Wedstrijden</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>📅</MudTh>
        <MudTh>Tegenstander</MudTh>
        <MudTh>📍</MudTh>
        <MudTh>Score</MudTh>
        <MudTh>🌰</MudTh>
        <MudTh>🏆</MudTh>
        <MudTh>⚽</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="📅">@context.Date.ToString("dd-MM")</MudTd>
        <MudTd DataLabel="Tegenstander">@context.Opponent</MudTd>
        <MudTd DataLabel="📍">@context.Location</MudTd>
        <MudTd DataLabel="Score"><MudText Color="GetScoreColor(context.Score, context.Location)">@context.Score</MudText></MudTd>
        <MudTd DataLabel="🌰">@context.Eikel</MudTd>
        <MudTd DataLabel="🏆">@string.Join(", ",context.ManOfTheMatch)</MudTd>
        <MudTd DataLabel="⚽">@FormatGoalScorers(context)</MudTd>
    </RowTemplate>
</MudTable>
