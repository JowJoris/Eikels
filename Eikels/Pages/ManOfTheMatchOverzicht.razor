@page "/motm-overzicht"
@using MudBlazor.Charts

<PageTitle>Man Of The Match Overzicht</PageTitle>

<MudTable Items="ManOfTheMatchList">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Man Of The Match</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Naam</MudTh>
        <MudTh>Aantal</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Naam">@context.Key</MudTd>
        <MudTd DataLabel="Aantal">@context.Value</MudTd>
    </RowTemplate>
</MudTable>