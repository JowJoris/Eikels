@page "/eikel-overzicht"
@using MudBlazor.Charts

<PageTitle>Eikel Overzicht</PageTitle>

<MudTable Items="EikelList">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Eikels</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Naam</MudTh>
        <MudTh>Aantal</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Naam">@context.Key</MudTd>
        <MudTd DataLabel="Aantal">@context.Value</MudTd>
    </RowTemplate>
</MudTable>